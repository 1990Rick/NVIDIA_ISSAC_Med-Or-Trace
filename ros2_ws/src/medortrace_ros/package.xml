<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>medortrace_ros</name>
  <version>0.1.0</version>
  <description>
    ROS 2 (Humble / Jazzy) interface of the MED-OR-TRACE object-chain verifier: runs the unmodified
    medortrace autonomy stack against the lite simulator, Isaac Sim or the physical prototype.
    Nodes: autonomy_node, sim_bridge_node, workflow_gateway_node, operator_console_node.
    Requires the medortrace Python package (pip install -e the repository, or set MEDORTRACE_ROOT).
  </description>
  <maintainer email="medortrace@example.org">MED-OR-TRACE maintainers</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>medortrace_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
