Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 12
      Offset: {X: 4, Y: 4, Z: 0}
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Occupancy belief
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Topic:
        Value: /medortrace/belief/occupancy
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.4
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar
      Enabled: true
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Decay Time: 0
      Topic:
        Value: /medortrace/sensors/lidar/points
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: EKF pose
      Enabled: true
      Shape: Arrow
      Topic:
        Value: /medortrace/localization/pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth (sim)
      Enabled: true
      Keep: 1
      Topic:
        Value: /medortrace/sim/ground_truth/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: NBV path
      Enabled: true
      Color: 255; 170; 0
      Topic:
        Value: /medortrace/planning/path
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 70
      X: 4.2
      Y: 4.1
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
